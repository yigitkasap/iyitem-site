---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileBar from '@/components/MobileBar.astro';
import FloatingActions from '@/components/FloatingActions.astro';
import { SITE, CONTACT, LOCALE_META, LOCALES, localePath, type Locale } from '@/lib/site';
import { useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Root-relative path without the locale prefix, e.g. "/hizmetlerimiz/". */
  path?: string;
  image?: string;
  noindex?: boolean;
  /** Extra JSON-LD blocks (BreadcrumbList, FAQPage…). */
  schemas?: unknown[];
}

const {
  locale,
  title,
  description = '',
  path = '/',
  image,
  noindex = false,
  schemas = [],
} = Astro.props;

const t = useTranslations(locale);
const meta = LOCALE_META[locale];

const pageTitle = path === '/' ? `${SITE.name} — ${SITE.legalName}` : `${title} | ${SITE.name}`;
const canonical = new URL(localePath(locale, path), SITE.url).href;
/** The 404 page has no real URL of its own: no canonical, no alternates. */
const isNotFound = path === '/404/';
const ogImage = new URL(image || SITE.logo, SITE.url).href;

const clinicSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: SITE.legalName,
  url: SITE.url,
  logo: new URL(SITE.logo, SITE.url).href,
  telephone: CONTACT.phone,
  faxNumber: CONTACT.fax,
  email: CONTACT.email,
  medicalSpecialty: 'Radiology',
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT.addressLine,
    addressLocality: 'Fatih',
    addressRegion: 'İstanbul',
    postalCode: '34096',
    addressCountry: 'TR',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '19:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '17:00',
    },
  ],
};
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Set before first paint so .reveal can hide content only when JS runs. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {!isNotFound && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      !isNotFound &&
      LOCALES.map((code) => (
        <link
          rel="alternate"
          hreflang={LOCALE_META[code].htmlLang}
          href={new URL(localePath(code, path), SITE.url).href}
        />
      ))
    }
    {!isNotFound && <link rel="alternate" hreflang="x-default" href={new URL(localePath('tr', path), SITE.url).href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={meta.htmlLang.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#e0231b" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={SITE.logo} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(clinicSchema)} />
    {
      schemas.map((schema) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
      ))
    }
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:text-white"
    >
      {t('label.skipToContent')}
    </a>

    <Header locale={locale} path={path} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer locale={locale} />
    <MobileBar locale={locale} />
    <FloatingActions locale={locale} />

    <script>
      /**
       * Scroll reveal. Sections get `.reveal`; their direct children are
       * staggered so a grid of cards arrives in sequence rather than all at
       * once. Elements already on screen at load are shown immediately, with
       * no transition, so the first paint is not animated into view.
       */
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));

      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
        );

        for (const el of targets) {
          // Stagger siblings inside the same grid/flex row.
          const siblings = el.parentElement ? [...el.parentElement.children] : [];
          const index = siblings.indexOf(el);
          if (index > 0 && siblings.length > 1) {
            el.style.setProperty('--reveal-delay', `${Math.min(index, 6) * 60}ms`);
          }
          observer.observe(el);
        }
      }
    </script>
  </body>
</html>
