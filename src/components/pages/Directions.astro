---
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import { CONTACT, MAPS_EMBED, MAPS_LINK, SITE, localePath, type Locale } from '@/lib/site';
import { useTranslations } from '@/i18n/ui';
import { DIRECTIONS_PAGE, pick } from '@/i18n/copy-pages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const copy = pick(DIRECTIONS_PAGE, locale);

const icons: Record<string, string> = {
  Metro: 'train',
  Tramvay: 'tram',
  Otobüs: 'bus',
  'Özel araç': 'car',
};
---

<PageHero
  locale={locale}
  title={copy.title}
  lead={copy.lead}
  tone="plain"
  crumbs={[{ label: t('nav.howToCome') }]}
/>

<section class="bg-surface-2 py-14">
  <div class="shell grid gap-8 lg:[grid-template-columns:minmax(0,1fr)_320px]">
    <div class="flex flex-col gap-8">
      <!-- Map -->
      <div class="overflow-hidden rounded-[18px] border border-line bg-white">
        <iframe
          title={`${SITE.name} — ${t('label.address')}`}
          src={MAPS_EMBED}
          width="100%"
          height="320"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block h-[320px] w-full border-0"></iframe>
        <div class="flex flex-wrap items-center justify-between gap-4 p-6">
          <p class="text-[15px] leading-[1.6] text-body">
            {CONTACT.addressLine}<br />{CONTACT.addressCity}
          </p>
          <a
            href={MAPS_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-[10px] bg-ink px-5 py-3 text-[13.5px] font-bold text-white transition-colors hover:bg-ink-dark hover:text-white"
          >
            {t('cta.directions')}
            <Icon name="externalLink" size={14} />
          </a>
        </div>
      </div>

      <!-- Routes -->
      <div class="grid gap-3.5 [grid-template-columns:repeat(auto-fit,minmax(260px,1fr))]">
        {
          copy.routes.map((r) => (
            <div class="reveal lift flex flex-col gap-2.5 rounded-[16px] border border-line bg-white p-6">
              <Icon name={icons[r.mode] ?? 'map-pin'} size={22} class="text-brand" />
              <span class="mono-meta text-muted">{r.mode}</span>
              <span class="text-[16.5px] font-bold leading-[1.3]">{r.title}</span>
              <p class="text-[14px] leading-[1.6] text-secondary">{r.text}</p>
            </div>
          ))
        }
      </div>

      <!-- Preparation -->
      <div class="flex flex-col gap-4 rounded-[18px] border border-line bg-white p-6 sm:p-8">
        <h2 class="h3">{copy.prepTitle}</h2>
        <ul class="flex flex-col">
          {
            copy.prep.map((p) => (
              <li class="grid gap-x-6 gap-y-1.5 border-b border-line-soft py-4 last:border-0 [@media(min-width:640px)]:[grid-template-columns:170px_minmax(0,1fr)]">
                <span class="text-[15px] font-bold">{p.title}</span>
                <span class="text-[14.5px] leading-[1.65] text-body">{p.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <aside class="flex flex-col gap-5 lg:sticky lg:top-24 lg:self-start">
      <div class="flex flex-col gap-3 rounded-[16px] border border-line bg-white p-6">
        <span class="mono-meta text-muted">{copy.bringTitle}</span>
        <ul class="flex flex-col gap-2.5">
          {
            copy.bring.map((b) => (
              <li class="flex items-start gap-2.5 text-[14px] leading-[1.5] text-body">
                <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand" />
                <span>{b}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col gap-2 rounded-[16px] border border-line bg-white p-6">
        <span class="mono-meta text-muted">{t('label.hours')}</span>
        {
          CONTACT.hoursRows.map((row) => (
            <div class="flex justify-between gap-4 border-b border-line-soft py-2 text-[14px] last:border-0">
              <span class="text-body">{row.day}</span>
              <span class="font-bold">{row.time}</span>
            </div>
          ))
        }
      </div>

      <div class="flex flex-col gap-3 rounded-[16px] bg-ink p-6 text-white">
        <span class="text-[17px] font-bold">{t('cta.appointment')}</span>
        <a href={CONTACT.phoneHref} class="text-[17px] font-bold text-white hover:text-white" dir="ltr">
          {CONTACT.phone}
        </a>
        <a
          href={localePath(locale, '/iletisim/#randevu')}
          class="rounded-[10px] bg-brand px-5 py-3 text-center text-[13.5px] font-bold text-white transition-colors hover:bg-brand-light hover:text-white"
        >
          {t('cta.appointment')}
        </a>
      </div>
    </aside>
  </div>
</section>
