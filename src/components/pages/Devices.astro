---
import PageHero from '../PageHero.astro';
import FactStrip from '../FactStrip.astro';
import { localePath, type Locale } from '@/lib/site';
import { useTranslations } from '@/i18n/ui';
import { byLocale, splitId } from '@/lib/content';
import { DEVICES_PAGE, pick } from '@/i18n/copy-pages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const copy = pick(DEVICES_PAGE, locale);
const devices = await byLocale('devices', locale);
---

<PageHero
  locale={locale}
  title={copy.title}
  lead={copy.lead}
  image="/assets/cihazlar-hero.webp"
  crumbs={[{ label: t('nav.devices') }]}
/>

<FactStrip facts={copy.facts} />

<section class="bg-surface-2 py-14">
  <div class="shell flex flex-col gap-[18px]">
    {
      devices.map((d) => {
        const slug = splitId(d.id).slug;
        const specs = copy.specs[slug] ?? [];
        return (
          <article class="reveal grid gap-0 overflow-hidden rounded-[18px] border border-line bg-white [@media(min-width:820px)]:[grid-template-columns:minmax(0,380px)_minmax(0,1fr)]">
            <img
              src={d.data.cover}
              alt=""
              width="760"
              height="570"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover [aspect-ratio:4/3] [@media(min-width:820px)]:[aspect-ratio:auto]"
            />
            <div class="flex flex-col gap-3 p-6 sm:p-8">
              <span class="mono-meta text-muted">{d.data.brand}</span>
              <h2 class="text-[clamp(20px,2vw,24px)] font-extrabold leading-[1.25]">{d.data.title}</h2>
              <p class="text-[15px] leading-[1.65] text-body">{d.data.summary}</p>

              {specs.length > 0 && (
                <ul class="flex flex-wrap gap-2 pt-1">
                  {specs.map((s) => (
                    <li class="rounded-full bg-surface px-3 py-1.5 text-[12.5px] font-semibold text-body">
                      {s}
                    </li>
                  ))}
                </ul>
              )}

              <div class="mt-auto flex flex-wrap gap-3 pt-4">
                <a
                  href={localePath(locale, `/cihazlarimiz/${slug}/`)}
                  class="rounded-[10px] bg-ink px-5 py-3 text-[13.5px] font-bold text-white transition-colors hover:bg-ink-dark hover:text-white"
                >
                  {t('cta.deviceDetail')}
                </a>
                <a
                  href={localePath(locale, '/iletisim/#randevu')}
                  class="rounded-[10px] border border-line-input px-5 py-3 text-[13.5px] font-bold text-ink transition-colors hover:border-ink"
                >
                  {t('cta.appointment')}
                </a>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
