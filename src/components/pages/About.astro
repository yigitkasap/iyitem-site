---
import PageHero from '../PageHero.astro';
import FactStrip from '../FactStrip.astro';
import TranslationNotice from '../TranslationNotice.astro';
import { CONTACT, localePath, type Locale } from '@/lib/site';
import { useTranslations } from '@/i18n/ui';
import { oneBySlug, splitFaq } from '@/lib/content';
import { ABOUT_PAGE, pick } from '@/i18n/copy-pages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const copy = pick(ABOUT_PAGE, locale);

const page = await oneBySlug('pages', locale, 'hakkimizda');
const { body } = splitFaq(page?.body);

/** The CMS page carries Güvenilir Hizmet / İlkelerimiz / Vizyon / Misyon as h1s. */
function section(heading: string): string {
  const escaped = heading.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const re = new RegExp(`<h1>(?:<strong>)?${escaped}(?:</strong>)?</h1>([\\s\\S]*?)(?=<h1>|$)`);
  return body.match(re)?.[1]?.replace(/<figure>[\s\S]*?<\/figure>/g, '').trim() ?? '';
}

const trusted = section('Güvenilir Hizmet') || section('Trusted Care') || section('خدمة جديرة بالثقة');
const vision = section('Vizyonumuz') || section('Our Vision') || section('رؤيتنا');
const mission = section('Misyonumuz') || section('Our Mission') || section('رسالتنا');
---

<PageHero
  locale={locale}
  title={copy.title}
  lead={copy.lead}
  image="/assets/about-hero.webp"
  crumbs={[{ label: t('nav.about') }]}
/>

<FactStrip facts={copy.facts} />

<!-- Trusted service split -->
<section id="guvenilir-hizmet" class="shell grid items-center gap-11 py-16 [grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr))]">
  <div class="flex min-w-0 flex-col gap-4">
    <span class="mono-label text-brand">{t('nav.trustedService')}</span>
    {page?.data.draftTranslation && <TranslationNotice locale={locale} />}
    <div class="prose-iyitem" set:html={trusted} />
  </div>
  <img
    src="/assets/about-2.webp"
    alt=""
    width="900"
    height="720"
    loading="lazy"
    decoding="async"
    class="w-full min-w-0 rounded-[18px] border border-line object-cover shadow-[var(--shadow-photo)] [aspect-ratio:5/4]"
  />
</section>

<!-- Principles -->
<section id="ilkelerimiz" class="bg-surface py-16">
  <div class="shell flex flex-col gap-7">
    <h2 class="h2">{copy.principlesTitle}</h2>
    <div class="grid gap-[18px] [grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr))]">
      {
        copy.principles.map((p) => (
          <div class="reveal lift flex gap-4 rounded-[16px] border border-line bg-white p-6">
            <span class="mono-label h-fit rounded-full border border-[#f3cdcb] px-2.5 py-1 text-brand">
              {p.no}
            </span>
            <p class="text-[15px] leading-[1.6] text-body">{p.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Vision & mission -->
<section id="vizyon-misyon" class="shell grid gap-6 py-16 [grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr))]">
  <div class="flex flex-col gap-4 rounded-[18px] bg-ink p-8 text-white">
    <span class="mono-label text-hero-tag">{locale === 'tr' ? 'Vizyonumuz' : 'Vision'}</span>
    <div class="prose-iyitem [&_*]:text-white/80" set:html={vision} />
  </div>
  <div class="flex flex-col gap-4 rounded-[18px] border border-line bg-white p-8">
    <span class="mono-label text-brand">{locale === 'tr' ? 'Misyonumuz' : 'Mission'}</span>
    <div class="prose-iyitem" set:html={mission} />
  </div>
</section>

<!-- Equipment list -->
<section class="bg-surface py-16">
  <div class="shell flex flex-col gap-6">
    <h2 class="h2">{copy.devicesTitle}</h2>
    <ul class="flex flex-col">
      {
        copy.devices.map((d) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-line-soft py-4">
            <span class="text-[17px] font-bold">{d.name}</span>
            <span class="text-[14px] text-secondary">{d.note}</span>
          </li>
        ))
      }
    </ul>
    <a
      href={localePath(locale, '/cihazlarimiz/')}
      class="self-start border-b-2 border-brand pb-[3px] text-[15px] font-bold"
    >
      {t('nav.devices')} →
    </a>
  </div>
</section>

<!-- Red CTA -->
<section class="shell py-16">
  <div class="flex flex-wrap items-center justify-between gap-6 rounded-[18px] bg-brand p-9 text-white">
    <div class="flex max-w-xl flex-col gap-2">
      <h2 class="text-[clamp(22px,2.4vw,30px)] font-extrabold text-white">{copy.ctaTitle}</h2>
      <p class="text-[15px] leading-[1.6] text-white/85">{copy.ctaBody}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a
        href={localePath(locale, '/iletisim/#randevu')}
        class="rounded-[10px] bg-white px-6 py-3.5 text-[14.5px] font-bold text-brand transition-opacity hover:opacity-90 hover:text-brand"
      >
        {t('cta.appointment')}
      </a>
      <a
        href={CONTACT.phoneHref}
        class="rounded-[10px] border border-white/60 px-6 py-3.5 text-[14.5px] font-bold text-white transition-colors hover:bg-white/15 hover:text-white"
      >
        {CONTACT.phone}
      </a>
    </div>
  </div>
</section>
