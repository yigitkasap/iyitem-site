---
import PageHero from '../PageHero.astro';
import { localePath, type Locale } from '@/lib/site';
import { useTranslations } from '@/i18n/ui';
import { byLocale, splitId } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = await byLocale('blog', locale);
const [featured, ...rest] = posts;
---

<PageHero
  locale={locale}
  title={t('nav.blog')}
  lead={t('blog.lead')}
  crumbs={[{ label: t('nav.blog') }]}
/>

<section class="bg-surface-2 py-14">
  <div class="shell grid gap-8 lg:[grid-template-columns:minmax(0,1fr)_300px]">
    <div class="flex flex-col gap-6">
      {
        featured && (
          <a
            href={localePath(locale, `/blog/${splitId(featured.id).slug}/`)}
            class="group grid overflow-hidden rounded-[18px] border border-line bg-white text-ink lift reveal hover:text-ink hover:shadow-[var(--shadow-card)] [@media(min-width:820px)]:[grid-template-columns:minmax(0,1fr)_minmax(0,1fr)]"
          >
            <img
              src={featured.data.cover}
              alt=""
              width="760"
              height="475"
              loading="eager"
              decoding="async"
              class="h-full w-full bg-[#0b0b0b] object-cover [aspect-ratio:16/10] [@media(min-width:820px)]:[aspect-ratio:auto]"
            />
            <span class="flex flex-col gap-3 p-7">
              <span class="w-fit rounded-full bg-brand px-3 py-1 text-[11.5px] font-bold uppercase tracking-wide text-white">
                {t('label.featured')}
              </span>
              <span class="text-[clamp(20px,2vw,26px)] font-extrabold leading-[1.25]">
                {featured.data.title}
              </span>
              <span class="mono-meta text-muted">{featured.data.date}</span>
              <span class="line-clamp-3 text-[14.5px] leading-[1.65] text-secondary">
                {featured.data.summary || featured.data.lead}
              </span>
              <span class="pt-1 text-[13.5px] font-bold text-brand">{t('cta.readMore')} →</span>
            </span>
          </a>
        )
      }

      <div class="grid gap-[18px] [grid-template-columns:repeat(auto-fill,minmax(280px,1fr))]">
        {
          rest.map((p) => (
            <a
              href={localePath(locale, `/blog/${splitId(p.id).slug}/`)}
              class="group flex flex-col overflow-hidden rounded-[14px] border border-line bg-white text-ink lift reveal hover:text-ink hover:shadow-[var(--shadow-card)]"
            >
              <img
                src={p.data.cover}
                alt=""
                width="600"
                height="375"
                loading="lazy"
                decoding="async"
                class="zoom block w-full bg-[#0b0b0b] object-cover [aspect-ratio:16/10]"
              />
              <span class="flex flex-1 flex-col gap-2 p-5">
                <span class="mono-meta text-muted">{p.data.date}</span>
                <span class="text-[17px] font-bold leading-[1.3]">{p.data.title}</span>
                <span class="line-clamp-3 text-[13.5px] leading-[1.6] text-secondary">
                  {p.data.summary || p.data.lead}
                </span>
                <span class="mt-auto pt-2 text-[13.5px] font-bold text-brand">
                  {t('cta.readMore')} →
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <aside class="flex flex-col gap-5 lg:sticky lg:top-24 lg:self-start">
      <div class="flex flex-col gap-3 rounded-[16px] border border-line bg-white p-6">
        <span class="mono-meta text-muted">{t('label.recentPosts')}</span>
        {
          posts.map((p) => (
            <a
              href={localePath(locale, `/blog/${splitId(p.id).slug}/`)}
              class="border-b border-line-soft pb-3 text-[14px] font-semibold leading-[1.45] text-ink last:border-0 last:pb-0 hover:text-brand"
            >
              {p.data.title}
            </a>
          ))
        }
      </div>

      <div class="flex flex-col gap-3 rounded-[16px] bg-ink p-6 text-white">
        <span class="text-[17px] font-bold">{t('cta.appointment')}</span>
        <p class="text-[13.5px] leading-[1.6] text-white/75">
          {t('blog.sideBody')}
        </p>
        <a
          href={localePath(locale, '/iletisim/#randevu')}
          class="rounded-[10px] bg-brand px-5 py-3 text-center text-[13.5px] font-bold text-white transition-colors hover:bg-brand-light hover:text-white"
        >
          {t('cta.appointment')}
        </a>
      </div>
    </aside>
  </div>
</section>
