---
import Hero from '../Hero.astro';
import Icon from '../Icon.astro';
import AppointmentBlock from '../AppointmentBlock.astro';
import Carousel from '../Carousel.astro';
import {
  BRANDS,
  SHORTCUTS,
  localePath,
  type Locale,
} from '@/lib/site';
import { useTranslations, type UIKey } from '@/i18n/ui';
import { byLocale, splitId } from '@/lib/content';
import { HOME } from '@/i18n/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const copy = HOME[locale] ?? HOME.tr;

const [departments, doctors, posts] = await Promise.all([
  byLocale('departments', locale),
  byLocale('doctors', locale),
  byLocale('blog', locale),
]);

const slides = copy.slides.map((s, i) => ({ ...s, image: `/assets/hero-${i + 1}.webp` }));
const featured = departments.slice(0, 8);

const cardShell =
  'group flex flex-col overflow-hidden rounded-[14px] border border-line bg-white text-ink lift reveal hover:text-ink hover:shadow-[var(--shadow-card)]';
---

<Hero locale={locale} slides={slides} />

<!-- Shortcut cards, riding over the hero -->
<section class="shell -translate-y-10">
  <div class="grid gap-3.5 [grid-template-columns:repeat(auto-fit,minmax(min(215px,100%),1fr))]">
    {
      SHORTCUTS.map((s) => (
        <a
          href={localePath(locale, s.href)}
          class="flex flex-col gap-2.5 rounded-[14px] border border-line bg-white p-[22px] text-ink shadow-[var(--shadow-lift)] lift reveal hover:text-ink hover:shadow-[var(--shadow-card-hover)]"
        >
          <span
            class="flex h-10 w-10 items-center justify-center rounded-[11px] text-white"
            style={`background:${s.color}`}
          >
            <Icon name={s.icon} size={20} />
          </span>
          <span class="text-[16.5px] font-bold">{t(`card.${s.key}.title` as UIKey)}</span>
          <span class="text-[13.5px] leading-[1.5] text-secondary">
            {t(`card.${s.key}.desc` as UIKey)}
          </span>
          <span class="mt-0.5 text-[13.5px] font-bold text-brand">
            {t(`cta.${s.key === 'appointment' ? 'appointment' : s.key === 'report' ? 'viewReport' : s.key === 'checkup' ? 'review' : 'viewMap'}` as UIKey)}
            →
          </span>
        </a>
      ))
    }
  </div>
</section>

<!-- Equipment brand strip -->
<section class="border-b border-line-soft">
  <div class="shell flex flex-wrap items-center justify-between gap-x-9 gap-y-3 pb-9 pt-2">
    <span class="mono-meta text-muted">{copy.brandsLabel}</span>
    <span class="flex flex-wrap gap-x-[26px] gap-y-2.5 text-[15px] font-bold text-[#3c4a58]">
      {BRANDS.map((b) => <span>{b}</span>)}
    </span>
  </div>
</section>

<!-- About split -->
<section
  class="shell grid items-center gap-11 py-16 [grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr))]"
>
  <div class="flex min-w-0 flex-col gap-4">
    <span class="mono-label text-brand">{t('nav.about')}</span>
    <h2 class="h2">{copy.about.title}</h2>
    <p class="text-[16.5px] leading-[1.7] text-body">{copy.about.body}</p>

    <div class="grid gap-3.5 pt-1.5 [grid-template-columns:repeat(auto-fit,minmax(min(120px,100%),1fr))]">
      {
        copy.about.stats.map((stat) => (
          <div class="flex flex-col">
            <span class="text-[28px] font-extrabold text-brand">{stat.value}</span>
            <span class="text-[13px] text-secondary">{stat.label}</span>
          </div>
        ))
      }
    </div>

    <a
      href={localePath(locale, '/hakkimizda/')}
      class="mt-1.5 self-start border-b-2 border-brand pb-[3px] text-[15px] font-bold"
    >
      {t('cta.readMore')}
    </a>
  </div>

  <img
    src="/assets/about.webp"
    alt={copy.about.imageAlt}
    width="1080"
    height="1000"
    loading="lazy"
    decoding="async"
    class="w-full min-w-0 rounded-[18px] border border-line object-cover shadow-[var(--shadow-photo)] [aspect-ratio:5/4]"
  />
</section>

<!-- Services -->
<section class="bg-surface py-16">
  <div class="shell flex flex-col gap-7">
    <div class="flex flex-wrap items-end justify-between gap-3.5">
      <div class="flex max-w-[620px] flex-col gap-2">
        <span class="mono-label text-brand">{t('nav.services')}</span>
        <h2 class="h2">{copy.services.title}</h2>
      </div>
      <a
        href={localePath(locale, '/hizmetlerimiz/')}
        class="border-b-2 border-brand pb-[3px] text-[15px] font-bold"
      >
        {t('cta.allServices')} ({departments.length})
      </a>
    </div>

    <div class="grid gap-[18px] [grid-template-columns:repeat(auto-fill,minmax(min(265px,100%),1fr))]">
      {
        featured.map((s) => (
          <a href={localePath(locale, `/hizmetlerimiz/${splitId(s.id).slug}/`)} class={cardShell}>
            <img
              src={s.data.cover}
              alt=""
              width="600"
              height="375"
              loading="lazy"
              decoding="async"
              class="zoom block w-full object-cover [aspect-ratio:16/10]"
            />
            <span class="flex flex-col gap-[7px] p-5">
              <span class="text-[16.5px] font-bold leading-[1.3]">{s.data.title}</span>
              <span class="line-clamp-3 text-[13.5px] leading-[1.55] text-secondary">
                {s.data.summary}
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- Double check / doctors -->
<section class="shell flex flex-col gap-7 py-16">
  <div class="flex max-w-[700px] flex-col gap-2.5">
    <span class="mono-label text-brand">{copy.doctors.label}</span>
    <h2 class="h2">{copy.doctors.title}</h2>
    <p class="text-[16.5px] leading-[1.7] text-body">{copy.doctors.body}</p>
  </div>

  <div class="grid gap-[18px] [grid-template-columns:repeat(auto-fit,minmax(min(255px,100%),1fr))]">
    {
      doctors.map((d) => (
        <div class="flex flex-col overflow-hidden rounded-[14px] border border-line bg-white">
          <img
            src={d.data.cover}
            alt={d.data.title}
            width="876"
            height="1000"
            loading="lazy"
            decoding="async"
            class="block w-full object-cover object-top [aspect-ratio:1/1]"
          />
          <div class="grid flex-1 gap-[5px] p-5 [grid-template-rows:auto_auto_1fr_1fr_auto]">
            <span class="text-[17.5px] font-bold">{d.data.title}</span>
            <span class="text-[13.5px] text-secondary">
              {d.data.specialty || t('label.specialty')}
            </span>
            <span class="pt-1.5 text-[13px] leading-[1.5] text-secondary">{d.data.education}</span>
            <span class="text-[13px] leading-[1.5] text-secondary">{d.data.interests}</span>
            <a
              href={localePath(locale, `/doktorlarimiz/${splitId(d.id).slug}/`)}
              class="self-end pt-2 text-sm font-bold"
            >
              {t('cta.viewCv')} →
            </a>
          </div>
        </div>
      ))
    }

    <div class="flex flex-col justify-center gap-3 rounded-[14px] bg-ink p-[26px] text-white">
      <span class="text-[18.5px] font-bold leading-[1.3]">{copy.reportCard.title}</span>
      <p class="text-sm leading-[1.6] text-white/75">{copy.reportCard.body}</p>
      <a
        href={localePath(locale, '/online-hizmetler/online-rapor/')}
        class="self-start rounded-[10px] bg-brand px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-light hover:text-white"
      >
        {t('cta.onlineReport')}
      </a>
    </div>
  </div>
</section>

<!-- Testimonials -->
<section class="bg-surface py-[60px]">
  <div class="shell grid items-center gap-11 [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
    <img
      src="/assets/testimonial.webp"
      alt=""
      width="1082"
      height="1002"
      loading="lazy"
      decoding="async"
      class="w-full min-w-0 rounded-[18px] border border-[#e0ddd8] object-cover [aspect-ratio:4/3]"
    />

    <div class="flex min-w-0 flex-col gap-4" data-quotes>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="mono-label text-brand">{copy.quotesLabel}</span>
        {copy.quotes.length > 1 && (
        <span class="flex gap-2">
          <button
            type="button"
            data-quote-prev
            aria-label="←"
            class="h-9 w-9 cursor-pointer rounded-[10px] border border-[#d9d5cf] bg-white text-[15px] text-ink transition-colors hover:bg-ink hover:text-white"
          >
            <Icon name="arrowLeft" size={15} class="mx-auto rtl:-scale-x-100" />
          </button>
          <button
            type="button"
            data-quote-next
            aria-label="→"
            class="h-9 w-9 cursor-pointer rounded-[10px] border border-[#d9d5cf] bg-white text-[15px] text-ink transition-colors hover:bg-ink hover:text-white"
          >
            <Icon name="arrowRight" size={15} class="mx-auto rtl:-scale-x-100" />
          </button>
        </span>
        )}
      </div>

      <div class="overflow-hidden">
        <div class="flex transition-transform duration-[450ms] ease-out" data-quote-track>
          {
            copy.quotes.map((q) => (
              <div class="flex flex-[0_0_100%] flex-col gap-3.5 pe-0.5">
                <p class="min-h-[4.4em] border-s-[3px] border-brand ps-[18px] text-[clamp(18px,2vw,23px)] font-semibold leading-[1.45]">
                  {q.text}
                </p>
                <span class="text-[15px] font-bold">— {q.name}</span>
                {q.meta && <span class="text-[13px] text-secondary">{q.meta}</span>}
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex items-center gap-[7px]">
        {
          copy.quotes.length > 1 && copy.quotes.map((_, i) => (
            <button
              type="button"
              data-quote-dot={i}
              aria-label={`${i + 1}`}
              class="h-[5px] w-6 cursor-pointer rounded-full border-0 p-0"
              style={`background:${i === 0 ? 'var(--color-brand)' : '#cfcac2'}`}
            />
          ))
        }
        <a
          href={localePath(locale, '/dilek-ve-onerileriniz/')}
          class="ms-auto whitespace-nowrap border-b-2 border-brand pb-0.5 text-sm font-bold"
        >
          {t('cta.addReview')}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Latest articles -->
{
  posts.length > 0 && (
    <section class="shell flex flex-col gap-[26px] py-16">
      <div class="flex flex-wrap items-end justify-between gap-3.5">
        <h2 class="text-[clamp(25px,2.8vw,34px)] font-extrabold">{copy.postsTitle}</h2>
        <span class="flex items-center gap-2">
          <a
            href={localePath(locale, '/blog/')}
            class="me-2 whitespace-nowrap border-b-2 border-brand pb-[3px] text-[15px] font-bold"
          >
            {t('cta.allPosts')}
          </a>
        </span>
      </div>

      <Carousel id="home-posts" label={copy.postsTitle} perView={3}>
        {posts.map((p) => (
          <a href={localePath(locale, `/blog/${splitId(p.id).slug}/`)} class={cardShell}>
            <img
              src={p.data.cover}
              alt=""
              width="640"
              height="400"
              loading="lazy"
              decoding="async"
              class="zoom block w-full bg-[#0b0b0b] object-cover [aspect-ratio:16/10]"
            />
            <span class="flex flex-col gap-2 p-5">
              <span class="mono-meta tracking-normal text-muted">{p.data.date}</span>
              <span class="text-[17px] font-bold leading-[1.3]">{p.data.title}</span>
              <span class="line-clamp-3 text-[13.5px] leading-[1.6] text-secondary">
                {p.data.summary || p.data.lead}
              </span>
              <span class="pt-0.5 text-[13.5px] font-bold text-brand">{t('cta.readMore')} →</span>
            </span>
          </a>
        ))}
      </Carousel>
    </section>
  )
}

<!-- Appointment -->
<AppointmentBlock locale={locale} id="randevu" />

<script>
  // Testimonial carousel — one quote per view, wraps around.
  document.querySelectorAll<HTMLElement>('[data-quotes]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-quote-track]');
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-quote-dot]'));
    if (!track || dots.length < 2) return;

    let i = 0;
    const show = (next: number) => {
      i = (next + dots.length) % dots.length;
      const rtl = getComputedStyle(track).direction === 'rtl';
      track.style.transform = `translateX(${(rtl ? 1 : -1) * i * 100}%)`;
      dots.forEach(
        (d, n) => (d.style.background = n === i ? 'var(--color-brand)' : '#cfcac2')
      );
    };

    root.querySelector('[data-quote-prev]')?.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-quote-next]')?.addEventListener('click', () => show(i + 1));
    dots.forEach((d, n) => d.addEventListener('click', () => show(n)));
  });
</script>
