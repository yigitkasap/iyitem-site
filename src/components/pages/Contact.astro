---
import PageHero from '../PageHero.astro';
import ContactForm from '../ContactForm.astro';
import AppointmentBlock from '../AppointmentBlock.astro';
import Icon from '../Icon.astro';
import { CONTACT, MAPS_EMBED, MAPS_LINK, SITE, localePath, type Locale } from '@/lib/site';
import { useTranslations } from '@/i18n/ui';
import { CONTACT_PAGE, pick } from '@/i18n/copy-pages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const copy = pick(CONTACT_PAGE, locale);
---

<PageHero
  locale={locale}
  title={copy.title}
  lead={copy.lead}
  crumbs={[{ label: t('nav.contact') }]}
/>

<!-- Channels -->
<section class="bg-surface">
  <div class="shell grid gap-3.5 py-10 [grid-template-columns:repeat(auto-fit,minmax(220px,1fr))]">
    {
      copy.channels.map((c) => (
        <a
          href={c.href}
          target={c.href.startsWith('http') ? '_blank' : undefined}
          rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="flex flex-col gap-1.5 rounded-[14px] border border-line bg-white p-5 text-ink lift reveal hover:text-ink hover:shadow-[var(--shadow-card)]"
        >
          <span class="mono-meta text-muted">{c.label}</span>
          <span class="text-[17px] font-bold">{c.value}</span>
          <span class="text-[13px] text-secondary">{c.note}</span>
        </a>
      ))
    }
  </div>
</section>

<!-- Form + map -->
<section class="shell grid gap-8 py-14 lg:[grid-template-columns:minmax(0,1.15fr)_minmax(0,1fr)]">
  <div class="flex flex-col gap-5">
    <h2 class="h2">{t('nav.contact')}</h2>
    <ContactForm locale={locale} variant="contact" id="contact-page" />
  </div>

  <div class="flex flex-col gap-5">
    <div class="overflow-hidden rounded-[18px] border border-line">
      <iframe
        title={`${SITE.name} — ${t('label.address')}`}
        src={MAPS_EMBED}
        width="100%"
        height="300"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="block h-[300px] w-full border-0"></iframe>
    </div>

    <div class="flex flex-col gap-3 rounded-[16px] border border-line bg-white p-6">
      <span class="mono-meta text-muted">{t('label.address')}</span>
      <p class="text-[15px] leading-[1.6] text-body">
        {CONTACT.addressLine}<br />{CONTACT.addressCity}
      </p>
      <a
        href={MAPS_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-fit items-center gap-1.5 border-b-2 border-brand pb-[3px] text-[14px] font-bold"
      >
        {t('cta.directions')}
        <Icon name="externalLink" size={14} />
      </a>
    </div>

    <div class="flex flex-col gap-2 rounded-[16px] border border-line bg-white p-6">
      <span class="mono-meta text-muted">{t('label.hours')}</span>
      {
        CONTACT.hoursRows.map((row) => (
          <div class="flex justify-between gap-4 border-b border-line-soft py-2 text-[14.5px] last:border-0">
            <span class="text-body">{row.day}</span>
            <span class="font-bold">{row.time}</span>
          </div>
        ))
      }
    </div>

    <div class="flex flex-col gap-2.5 rounded-[16px] bg-ink p-6 text-white">
      <span class="text-[16px] font-bold">{copy.transitTitle}</span>
      <p class="text-[13.5px] leading-[1.6] text-white/75">{copy.transitBody}</p>
      <a
        href={localePath(locale, '/nasil-gelmelisiniz/')}
        class="w-fit border-b-2 border-brand pb-0.5 text-[13.5px] font-bold text-white hover:text-white"
      >
        {t('nav.howToCome')} →
      </a>
    </div>
  </div>
</section>

<AppointmentBlock locale={locale} id="randevu" />
