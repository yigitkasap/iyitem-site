---
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import { CONTACT, localePath, type Locale } from '@/lib/site';
import { useTranslations } from '@/i18n/ui';
import { CHECKUP_PAGE, pick } from '@/i18n/copy-pages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const copy = pick(CHECKUP_PAGE, locale);
---

<PageHero
  locale={locale}
  title={copy.title}
  lead={copy.lead}
  image="/assets/svc-checkup.webp"
  crumbs={[{ label: t('nav.checkup') }]}
>
  <div class="mt-7 flex flex-wrap gap-3">
    <a
      href={localePath(locale, '/iletisim/#randevu')}
      class="rounded-[10px] bg-brand px-6 py-3.5 text-[14.5px] font-bold text-white transition-colors hover:bg-brand-light hover:text-white"
    >
      {t('cta.appointment')}
    </a>
    <a
      href={CONTACT.phoneHref}
      class="rounded-[10px] border border-white/45 px-6 py-3.5 text-[14.5px] font-bold text-white transition-colors hover:bg-white/15 hover:text-white"
      dir="ltr"
    >
      {CONTACT.phone}
    </a>
  </div>
</PageHero>

<section class="bg-surface-2 py-14">
  <div class="shell flex flex-col gap-8">
    <div class="flex max-w-3xl flex-col gap-3">
      <h2 class="h2">{copy.packagesTitle}</h2>
      <p class="text-[16px] leading-[1.7] text-body">{copy.intro}</p>
    </div>

    <div class="grid gap-[18px] [grid-template-columns:repeat(auto-fit,minmax(230px,1fr))]">
      {
        copy.packages.map((p) => (
          <article class="reveal lift flex flex-col gap-5 rounded-[18px] border border-line bg-white p-7">
            <Icon name="heart-pulse" size={26} class="text-brand" />
            <h3 class="text-[20px] font-extrabold leading-[1.25]">{p.title}</h3>
            <a
              href={CONTACT.phoneHref}
              class="mt-auto rounded-[10px] bg-ink px-5 py-3 text-center text-[13.5px] font-bold text-white transition-opacity hover:text-white hover:opacity-90"
            >
              {copy.packageCta}
            </a>
          </article>
        ))
      }
    </div>

    <p
      class="flex items-start gap-3 rounded-[14px] border border-warn-line bg-warn-bg px-5 py-4 text-[14.5px] leading-[1.6] text-warn-ink"
      role="note"
    >
      <Icon name="info" size={18} class="mt-0.5 shrink-0" />
      <span>
        {copy.priceNote}{' '}
        <a href={CONTACT.phoneHref} class="font-bold" dir="ltr">{CONTACT.phone}</a>
      </span>
    </p>
  </div>
</section>
