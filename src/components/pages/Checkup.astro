---
import PageHero from '../PageHero.astro';
import Steps from '../Steps.astro';
import Icon from '../Icon.astro';
import { CONTACT, localePath, type Locale } from '@/lib/site';
import { useTranslations } from '@/i18n/ui';
import { CHECKUP_PAGE, pick } from '@/i18n/copy-pages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const copy = pick(CHECKUP_PAGE, locale);
---

<PageHero
  locale={locale}
  title={copy.title}
  lead={copy.lead}
  image="/assets/svc-checkup.webp"
  crumbs={[{ label: t('nav.checkup') }]}
>
  <div class="mt-7 flex flex-wrap gap-3">
    <a
      href={localePath(locale, '/iletisim/#randevu')}
      class="rounded-[10px] bg-brand px-6 py-3.5 text-[14.5px] font-bold text-white transition-colors hover:bg-brand-light hover:text-white"
    >
      {t('cta.appointment')}
    </a>
    <a
      href={CONTACT.phoneHref}
      class="rounded-[10px] border border-white/45 px-6 py-3.5 text-[14.5px] font-bold text-white transition-colors hover:bg-white/15 hover:text-white"
    >
      {CONTACT.phone}
    </a>
  </div>
</PageHero>

<!-- Packages -->
<section class="bg-surface-2 py-14">
  <div class="shell grid gap-[18px] [grid-template-columns:repeat(auto-fit,minmax(280px,1fr))]">
    {
      copy.packages.map((p) => (
        <article
          class:list={[
            'reveal lift relative flex flex-col gap-4 rounded-[18px] border p-7',
            p.featured ? 'border-brand bg-brand text-white' : 'border-line bg-white',
          ]}
        >
          {p.featured && (
            <span class="absolute -top-3 start-7 rounded-full bg-white px-3 py-1 text-[11.5px] font-bold text-brand">
              En çok tercih edilen
            </span>
          )}

          <span class:list={['mono-meta', p.featured ? 'text-white/70' : 'text-muted']}>{p.tag}</span>
          <h2 class:list={['text-[20px] font-extrabold leading-[1.25]', p.featured && 'text-white']}>
            {p.title}
          </h2>
          <p class:list={['text-[14px] leading-[1.6]', p.featured ? 'text-white/85' : 'text-secondary']}>
            {p.desc}
          </p>

          <ul class="flex flex-col gap-2.5 pt-1">
            {p.items.map((item) => (
              <li
                class:list={[
                  'flex items-start gap-2.5 text-[14px] leading-[1.5]',
                  p.featured ? 'text-white/90' : 'text-body',
                ]}
              >
                <Icon
                  name="check"
                  size={16}
                  class={`mt-0.5 shrink-0 ${p.featured ? 'text-white' : 'text-brand'}`}
                />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <span
            class:list={[
              'mono-meta pt-1 leading-[1.5]',
              p.featured ? 'text-white/70' : 'text-muted',
            ]}
          >
            {p.note}
          </span>

          <a
            href={localePath(locale, '/iletisim/#randevu')}
            class:list={[
              'mt-auto rounded-[10px] px-5 py-3 text-center text-[13.5px] font-bold transition-opacity hover:opacity-90',
              p.featured ? 'bg-white text-brand hover:text-brand' : 'bg-ink text-white hover:text-white',
            ]}
          >
            {t('cta.appointment')}
          </a>
        </article>
      ))
    }
  </div>
</section>

<Steps title={copy.stepsTitle} items={copy.steps} />

<!-- FAQ + price note -->
<section class="bg-surface py-16">
  <div class="shell shell-narrow flex flex-col gap-6">
    <h2 class="h2">{t('label.faqTitle')}</h2>
    <div class="grid gap-3.5 [grid-template-columns:repeat(auto-fit,minmax(300px,1fr))]">
      {
        copy.faq.map((f) => (
          <div class="reveal flex flex-col gap-2.5 rounded-[16px] border border-line bg-white p-6">
            <span class="text-[16px] font-bold leading-[1.35]">{f.q}</span>
            <p class="text-[14px] leading-[1.6] text-secondary">{f.a}</p>
          </div>
        ))
      }
    </div>

    <p
      class="flex items-start gap-3 rounded-[14px] border border-warn-line bg-warn-bg px-5 py-4 text-[14px] leading-[1.6] text-warn-ink"
      role="note"
    >
      <Icon name="info" size={18} class="mt-0.5 shrink-0" />
      <span>{copy.priceNote}</span>
    </p>
  </div>
</section>
