---
/** Numbered cards (01/02/03…) — the redesign's recurring "how it works" block. */
interface Props {
  title?: string;
  items: { no: string; title?: string; text: string }[];
  tone?: 'white' | 'surface';
  columns?: 2 | 3 | 4;
  class?: string;
}

const { title, items, tone = 'white', columns = 3, class: className = '' } = Astro.props;
const min = columns === 4 ? 210 : columns === 2 ? 320 : 260;
---

<section class:list={[tone === 'surface' ? 'bg-surface' : 'bg-white', 'py-16', className]}>
  <div class="shell flex flex-col gap-7">
    {title && <h2 class="h2">{title}</h2>}
    <div class="grid gap-[18px]" style={`grid-template-columns:repeat(auto-fit,minmax(${min}px,1fr))`}>
      {
        items.map((item) => (
          <div class="reveal lift flex flex-col gap-3 rounded-[16px] border border-line bg-white p-6">
            <span class="mono-label inline-flex w-fit rounded-full border border-[#f3cdcb] px-2.5 py-1 text-brand">
              {item.no}
            </span>
            {item.title && <span class="text-[18px] font-bold leading-[1.3]">{item.title}</span>}
            <p class="text-[14.5px] leading-[1.6] text-secondary">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
