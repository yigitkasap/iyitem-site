---
import { localePath, type Locale } from '@/lib/site';
import { useTranslations } from '@/i18n/ui';

/**
 * Homepage hero: three photos stacked absolutely, crossfading every 6s.
 * Matches the prototype's `min-height: min(78vh, 680px)` and scrim gradient.
 */
export interface Slide {
  image: string;
  tag: string;
  title: string;
  body: string;
}

interface Props {
  locale: Locale;
  slides: Slide[];
}

const { locale, slides } = Astro.props;
const t = useTranslations(locale);
---

<section
  class="relative isolate flex min-h-[min(78vh,680px)] items-center overflow-hidden bg-hero text-white"
  aria-roledescription="carousel"
>
  {
    slides.map((slide, i) => (
      <img
        src={slide.image}
        alt=""
        width="1920"
        height="900"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : undefined}
        decoding="async"
        data-hero-img
        class="absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ease-out"
        style={`opacity:${i === 0 ? 1 : 0}`}
      />
    ))
  }

  <div class="absolute inset-0 bg-[linear-gradient(100deg,rgba(9,17,24,.9)_0%,rgba(9,17,24,.72)_45%,rgba(9,17,24,.3)_100%)] rtl:bg-[linear-gradient(260deg,rgba(9,17,24,.9)_0%,rgba(9,17,24,.72)_45%,rgba(9,17,24,.3)_100%)]">
  </div>

  <div class="shell relative pb-[92px] pt-[72px]">
    <div class="flex max-w-[660px] flex-col items-start gap-5">
      {
        slides.map((slide, i) => (
          <div
            data-hero-panel
            hidden={i !== 0}
            class="flex flex-col items-start gap-5"
          >
            <span class="mono-label rounded-full border border-white/30 px-3 py-[7px] text-hero-tag">
              {slide.tag}
            </span>
            <h1 class="h1 text-white [text-shadow:0_2px_18px_rgba(0,0,0,.35)]">{slide.title}</h1>
            <p class="max-w-[540px] text-[17.5px] leading-[1.6] text-white/[.88] [text-shadow:0_1px_12px_rgba(0,0,0,.4)]">
              {slide.body}
            </p>
          </div>
        ))
      }

      <div class="flex flex-wrap gap-3 pt-1">
        <a
          href={localePath(locale, '/iletisim/#randevu')}
          class="whitespace-nowrap rounded-[10px] bg-brand px-[26px] py-[15px] text-[15px] font-bold text-white transition-colors hover:bg-brand-light hover:text-white"
        >
          {t('cta.appointment')}
        </a>
        <a
          href={localePath(locale, '/hizmetlerimiz/')}
          class="whitespace-nowrap rounded-[10px] border border-white/45 px-[26px] py-[15px] text-[15px] font-semibold text-white transition-colors hover:bg-white/15 hover:text-white"
        >
          {t('cta.exploreServices')}
        </a>
      </div>

      {
        slides.length > 1 && (
          <div class="flex items-center gap-[9px] pt-2.5">
            {slides.map((_, i) => (
              <button
                type="button"
                data-hero-dot={i}
                aria-label={`${i + 1}`}
                class="h-[5px] w-[30px] cursor-pointer rounded-full border-0 p-0 transition-colors"
                style={`background:${i === 0 ? 'var(--color-brand)' : 'rgba(255,255,255,.4)'}`}
              />
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  const imgs = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-img]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-panel]'));
  const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-dot]'));

  if (imgs.length > 1) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      current = (next + imgs.length) % imgs.length;
      imgs.forEach((img, i) => (img.style.opacity = i === current ? '1' : '0'));
      panels.forEach((panel, i) => (panel.hidden = i !== current));
      dots.forEach(
        (dot, i) =>
          (dot.style.background = i === current ? 'var(--color-brand)' : 'rgba(255,255,255,.4)')
      );
    };

    const start = () => {
      if (reduce) return;
      window.clearInterval(timer);
      timer = window.setInterval(() => show(current + 1), 6000);
    };

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      })
    );

    start();
  }
</script>
