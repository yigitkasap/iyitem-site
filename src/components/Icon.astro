---
/**
 * Inline lucide icons (24×24 viewBox, fill:none, stroke:currentColor,
 * stroke-width:2, round caps) — shipped as markup so there is no icon font
 * request. Names match the lucide set used in the design handoff.
 */
interface Props {
  name: string;
  class?: string;
  size?: number;
  strokeWidth?: number;
}
const { name, class: className = '', size = 20, strokeWidth = 2 } = Astro.props;

/**
 * Brand marks are solid glyphs, not line icons — they carry their own shape and
 * must not be redrawn as outlines. These render filled, with no stroke.
 */
