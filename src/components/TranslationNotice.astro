---
import Icon from './Icon.astro';
import type { Locale } from '@/lib/site';
import { useTranslations } from '@/i18n/ui';

/** Shown on machine-translated pages until the clinic signs them off. */
interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = '' } = Astro.props;
const t = useTranslations(locale);
---

<p
  class={`flex items-start gap-3 rounded-[var(--radius-card)] border border-amber-300/70 bg-amber-50 px-4 py-3 text-[13.5px] leading-relaxed text-amber-900 ${className}`}
  role="note"
>
  <Icon name="file-text" size={17} class="mt-0.5 shrink-0" />
  <span>{t('misc.translationDraft')}</span>
</p>
