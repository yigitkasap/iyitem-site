---
import { SCAN_OPTIONS, CONTACT, localePath, type Locale } from '@/lib/site';
import { useTranslations } from '@/i18n/ui';

/**
 * The four forms of the redesign share one component.
 *
 * The site is statically generated, so there are two submit paths:
 *   • `PUBLIC_FORM_ENDPOINT` set → POST there (Formspree, a Worker, …)
 *   • not set → hand the filled details to WhatsApp, which the clinic already
 *     runs as a booking channel
 *
 * Either way the visitor sees a working form, never a setup message, and a
 * request is never silently dropped.
 *
 * KVKK: the T.C. Kimlik numarası is only asked for on the POST path, where the
 * endpoint is covered by the clinic's data-processing agreement. See README.
 */
interface Props {
  locale: Locale;
  variant?: 'appointment' | 'contact' | 'suggestion' | 'compact';
  id?: string;
  /** Service slug; pre-selects the matching scan on a service detail page. */
  scan?: string;
  class?: string;
}

const { locale, variant = 'appointment', id = 'form', scan, class: className = '' } = Astro.props;
const t = useTranslations(locale);

/**
 * With an endpoint configured the form POSTs there. Without one it still
 * works: the submit hands the filled details to WhatsApp, which the clinic
 * already runs as a booking channel. Either way the visitor never sees a
 * setup message and a request is never silently dropped.
 */
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const viaWhatsApp = !endpoint;

const SUBJECTS = (['subject.appointment', 'subject.result', 'subject.price', 'subject.feedback', 'subject.other'] as const).map((k) => t(k));
---

<form
  id={id}
  data-form
  method="post"
  action={endpoint || undefined}
  novalidate
  class:list={[
    'flex flex-col gap-3.5 rounded-[18px] border border-line-form bg-white p-[26px] shadow-[var(--shadow-panel)]',
    className,
  ]}
>
  <div class="grid gap-3.5 [grid-template-columns:repeat(auto-fit,minmax(170px,1fr))]">
    <label class="field-label">
      {t('form.name')}
      <input type="text" name="name" required placeholder={t('form.namePh')} autocomplete="name" class="field" />
    </label>

    <label class="field-label">
      {t('form.phone')}
      <input
        type="tel"
        name="phone"
        required
        placeholder={t('form.phonePh')}
        autocomplete="tel"
        inputmode="tel"
        class="field"
      />
    </label>

    {
      variant === 'appointment' && (
        <>
          {/*
            The T.C. kimlik numarası is only collected when a real endpoint is
            configured — one covered by the clinic's data-processing agreement.
            It is never put into a WhatsApp draft; the clinic takes it at the
            appointment instead.
          */}
          {!viaWhatsApp && (
            <label class="field-label">
              {t('form.nationalId')}
              <input
                type="text"
                name="nationalId"
                required
                placeholder={t('form.nationalIdPh')}
                inputmode="numeric"
                maxlength="11"
                autocomplete="off"
                class="field"
              />
            </label>
          )}
          <label class="field-label">
            {t('form.date')}
            <input type="date" name="date" class="field" />
          </label>
        </>
      )
    }

    {
      variant !== 'appointment' && (
        <label class="field-label">
          {t('form.email')}
          <input type="email" name="email" required autocomplete="email" class="field" />
        </label>
      )
    }

    {
      variant === 'contact' && (
        <label class="field-label">
          {t('form.subject')}
          <select name="subject" class="field">
            {SUBJECTS.map((s) => (
              <option>{s}</option>
            ))}
          </select>
        </label>
      )
    }
  </div>

  {
    variant === 'appointment' && (
      <label class="field-label">
        {t('form.scan')}
        <select name="scan" class="field">
          {SCAN_OPTIONS.map((o) => (
            <option selected={!!scan && (o.slugs as readonly string[]).includes(scan)}>{t(o.key)}</option>
          ))}
        </select>
      </label>
    )
  }

  <label class="field-label">
    {variant === 'appointment' ? t('form.request') : t('form.message')}
    <textarea
      name="message"
      rows="3"
      required
      placeholder={variant === 'appointment' ? t('form.requestPh') : ''}
      class="field resize-y"></textarea>
  </label>

  {/* Honeypot — bots fill it, people never see it. */}
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  <label class="flex items-start gap-2.5 text-[13px] leading-[1.5] text-body">
    <input
      type="checkbox"
      name="consent"
      required
      class="mt-0.5 h-[17px] w-[17px] flex-none accent-[var(--color-brand)]"
    />
    <span>
      <a href={localePath(locale, '/hasta-haklari/#kvkk')}>{t('form.consentLink')}</a>
      {' '}{t('form.consent')}
    </span>
  </label>

  <button
    type="submit"
    class="w-full cursor-pointer rounded-[11px] border-0 bg-brand p-4 text-[15.5px] font-bold text-white transition-colors hover:bg-brand-dark"
  >
    {
      viaWhatsApp
        ? t('form.sendWhatsApp')
        : variant === 'appointment'
          ? t('cta.appointmentRequest')
          : t('cta.send')
    }
  </button>

  {
    viaWhatsApp && (
      <p class="text-center text-[13px] leading-[1.6] text-secondary">
        {t('form.orCall')}{' '}
        <a href={CONTACT.phoneHref} class="font-bold">
          {CONTACT.phone}
        </a>
      </p>
    )
  }

  <p data-form-status role="status" aria-live="polite" class="text-sm font-bold"></p>
</form>

<script
  is:inline
  define:vars={{
    okMsg: t('form.success'),
    errMsg: t('form.error'),
    sendingMsg: t('form.sending'),
    badPhone: t('form.invalidPhone'),
    badId: t('form.invalidId'),
    badEmail: t('form.invalidEmail'),
    waBase: CONTACT.whatsappHref,
    waIntro: t('form.waIntro'),
    waSent: t('form.waSent'),
  }}
>
  (() => {
    // T.C. kimlik numarası checksum (11 digits, algorithmic).
    const validId = (v) => {
      if (!/^[1-9][0-9]{10}$/.test(v)) return false;
      const d = v.split('').map(Number);
      const odd = d[0] + d[2] + d[4] + d[6] + d[8];
      const even = d[1] + d[3] + d[5] + d[7];
      if ((odd * 7 - even) % 10 !== d[9]) return false;
      return d.slice(0, 10).reduce((a, b) => a + b, 0) % 10 === d[10];
    };

    // Turkish mobile/landline, tolerant of spaces and +90.
    const validPhone = (v) => /^(\+?90)?0?\s?\(?\d{3}\)?[\s-]?\d{3}[\s-]?\d{2}[\s-]?\d{2}$/.test(v.trim());

    document.querySelectorAll('form[data-form]').forEach((form) => {
      const status = form.querySelector('[data-form-status]');
      const say = (msg, color) => {
        if (!status) return;
        status.textContent = msg;
        status.style.color = color;
      };

      form.addEventListener('submit', async (event) => {
        const phone = form.querySelector('[name="phone"]');
        const id = form.querySelector('[name="nationalId"]');
        const email = form.querySelector('[name="email"]');

        for (const [field, ok, msg] of [
          [phone, () => validPhone(phone.value), badPhone],
          [id, () => validId(id.value), badId],
          [email, () => /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email.value), badEmail],
        ]) {
          if (!field || !field.value) continue;
          if (!ok()) {
            event.preventDefault();
            field.focus();
            say(msg, 'var(--color-brand)');
            return;
          }
        }

        event.preventDefault();
        if (!form.reportValidity()) return;

        // No endpoint configured: hand the details to WhatsApp instead.
        if (!form.getAttribute('action')) {
          const label = (el) =>
            el.closest('label')?.childNodes[0]?.textContent?.trim() || el.name;
          const lines = [];
          for (const el of form.elements) {
            if (!el.name || el.name === '_gotcha' || el.type === 'checkbox') continue;
            if (!el.value) continue;
            lines.push(`${label(el)}: ${el.value}`);
          }
          const text = `${waIntro}\n\n${lines.join('\n')}`;
          window.open(`${waBase}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
          say(waSent, 'var(--color-success)');
          return;
        }

        const button = form.querySelector('button[type="submit"]');
        if (button) button.disabled = true;
        say(sendingMsg, '');

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) throw new Error(String(response.status));
          form.reset();
          say(okMsg, 'var(--color-success)');
        } catch {
          say(errMsg, 'var(--color-brand)');
        } finally {
          if (button) button.disabled = false;
        }
      });
    });
  })();
</script>
